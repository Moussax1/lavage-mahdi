{
  "expo": {
    "name": "Lavage de Mahdi",
    "slug": "lavage-mahdi",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon1.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080F1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lavage.mahdi",
      "infoPlist": {
        "NSCameraUsageDescription": "Utilisation de la caméra pour scanner les QR codes des cartes client.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080F1A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.lavage.mahdi"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Lavage de Mahdi",
      "lang": "fr",
      "backgroundColor": "#080F1A",
      "themeColor": "#1B8EF2",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Accès à la caméra pour scanner les QR codes clients."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f49dcc91-7a4f-4eef-9101-c226eb7e5bcb"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/f49dcc91-7a4f-4eef-9101-c226eb7e5bcb"
    }
  }
}
